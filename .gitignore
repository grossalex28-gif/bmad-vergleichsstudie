# Laufdaten. Aufgenommen ins Repository, damit die zwoelf Implementierungen
# auf einem anderen Rechner getestet und analysiert werden koennen. Nur die
# Build-Ausgabe und die gespiegelten Framework-Kopien sind ausgeschlossen,
# nicht Quellcode, Konfiguration, Sperrdateien oder Migrationen: Lock-Dateien
# und EF-Core-Migrationen werden fuer einen reproduzierbaren Build auf einem
# anderen Rechner gebraucht. Die vollstaendige Phasenhistorie samt Tags bleibt
# unabhaengig davon je Lauf als Bundle unter archiv/ erhalten (siehe unten).
runs/**/node_modules/
runs/**/bin/
runs/**/obj/
runs/**/dist/
runs/**/wwwroot/lib/

# Gespiegelte BMAD-Installation innerhalb der BMAD-Laeufe. Fremdcode ohne
# mitgelieferte Lizenzdatei, siehe Begruendung bei bmad-core-bmm/ unten.
# Zugleich der Befund aus der Erhebung, dass diese Kopie faelschlich als
# Produktivcode mitgezaehlt wuerde, waere sie nicht ausgeschlossen.
runs/**/.claude/
runs/**/.agents/
runs/**/_bmad/
runs/**/_bmad-output/

# Archive einzelner Laeufe (vollstaendige Git-Historie samt Phasen-Tags als
# Bundle, gepackte Logs, Manifest mit SHA-256). Werden ueber Releases bzw.
# Zenodo veroeffentlicht, nicht ueber die Repository-Historie.
archiv/

# BMAD-Installation. Fremdcode ohne mitgelieferte Lizenzdatei, deshalb nicht
# mitveroeffentlicht. Reproduzierbar ueber die gepinnte Version
# bmad-method@6.10.0; der Manifest-Hash steht in jeder config.json je Lauf.
bmad-core-bmm/

# Python
__pycache__/
*.pyc

# Sicherungskopien aus der Bearbeitung
.backup/

# Vom Harness entfernte, veraltete Verzeichnisinhalte, zum manuellen Loeschen
# vorgemerkt (siehe Hinweis in der jeweiligen Unterhaltung).
_to_delete/

# SonarQube-Zugangsdaten (lokal, nicht versionieren)
.env.sonarqube
sonar-ergebnisse/*.token

# SonarScanner-Arbeitsverzeichnisse (Cache/Report je Scan-Aufruf), ueberall im
# Baum -- weder Quellcode noch Analyseergebnis, wird bei jedem erneuten Lauf
# neu erzeugt. sonar-ergebnisse/*.json (die eigentlichen Kennzahlen) bleiben
# davon unberuehrt und werden weiterhin versioniert.
**/.sonarqube/
**/.scannerwork/

# .NET-Build-Ausgabe der A1-Akzeptanztest-Suite (analog zu runs/**/bin|obj/)
a1-testsuite/**/bin/
a1-testsuite/**/obj/

# SonarQube User-Token, falls lokal in einer eigenen Datei abgelegt (siehe
# docs/SonarQube_Setup.md Abschnitt 3) -- analog zu .env.sonarqube
.env.sonar-token
