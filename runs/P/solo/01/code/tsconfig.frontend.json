{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["src/public/**/*.ts", "src/shared/**/*.ts"]
}
