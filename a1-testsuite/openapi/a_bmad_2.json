  "components": {
    "schemas": {
      "BookingDto": {
        "required": [
          "reference",
          "name",
          "status",
          "positionen",
          "gesamtpreis"
        ],
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "positionen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingPositionDto"
            }
          },
          "gesamtpreis": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BookingPositionDto": {
        "required": [
          "rowLabel",
          "columnNumber",
          "preiskategorie"
        ],
        "type": "object",
        "properties": {
          "rowLabel": {
            "type": "string"
          },
          "columnNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "preiskategorie": {
            "$ref": "#/components/schemas/PriceCategoryDto"
          }
        }
      },
      "CreateBookingPositionRequestDto": {
        "required": [
          "rowLabel",
          "columnNumber",
          "priceCategoryId"
        ],
        "type": "object",
        "properties": {
          "rowLabel": {
            "type": "string"
          },
          "columnNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "priceCategoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateBookingRequestDto": {
        "required": [
          "eventId",
          "name",
          "email",
          "positionen"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "positionen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateBookingPositionRequestDto"
            }
          }
        }
      },
      "EventDetailDto": {
        "required": [
          "id",
          "titel",
          "beschreibung",
          "dauerMinuten",
          "altersfreigabe",
          "spielstaette",
          "raum",
          "zeitpunkt",
          "preiskategorien"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "titel": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "dauerMinuten": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "altersfreigabe": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "spielstaette": {
            "type": "string"
          },
          "raum": {
            "type": "string"
          },
          "zeitpunkt": {
            "type": "string",
            "format": "date-time"
          },
          "preiskategorien": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceCategoryDto"
            }
          }
        }
      },
      "EventSummaryDto": {
        "required": [
          "id",
          "titel",
          "spielstaette",
          "zeitpunkt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "titel": {
            "type": "string"
          },
          "spielstaette": {
            "type": "string"
          },
          "zeitpunkt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PriceCategoryDto": {
        "required": [
          "id",
          "name",
          "preis"
