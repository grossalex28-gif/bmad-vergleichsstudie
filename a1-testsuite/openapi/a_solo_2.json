  "components": {
    "schemas": {
      "BookingDto": {
        "required": [
          "reference",
          "eventId",
          "eventTitle",
          "eventStartsAt",
          "customerName",
          "customerEmail",
          "createdAt",
          "isCancelled",
          "totalPrice",
          "seats"
        ],
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "eventTitle": {
            "type": "string"
          },
          "eventStartsAt": {
            "type": "string",
            "format": "date-time"
          },
          "customerName": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCancelled": {
            "type": "boolean"
          },
          "totalPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "seats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingSeatDto"
            }
          }
        }
      },
      "BookingSeatDto": {
        "required": [
          "row",
          "column",
          "priceCategoryName",
          "price"
        ],
        "type": "object",
        "properties": {
          "row": {
            "type": "string"
          },
          "column": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "priceCategoryName": {
            "type": "string"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreateBookingRequestDto": {
        "required": [
          "eventId",
          "customerName",
          "customerEmail",
          "seats"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string"
          },
          "seats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateBookingSeatDto"
            }
          }
        }
      },
      "CreateBookingSeatDto": {
        "required": [
          "row",
          "column",
          "priceCategoryId"
        ],
        "type": "object",
        "properties": {
          "row": {
            "type": "string"
          },
          "column": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "priceCategoryId": {
            "type": "string"
          }
        }
      },
      "EventDetailDto": {
        "required": [
          "id",
          "title",
          "description",
          "durationMinutes",
          "ageRating",
          "venueId",
          "venueName",
          "roomId",
          "roomName",
          "startsAt",
          "priceCategories"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ageRating": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "venueId": {
            "type": "string"
          },
          "venueName": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "priceCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceCategoryDto"
            }
          }
        }
      },
      "EventListItemDto": {
        "required": [
          "id",
          "title",
          "venueId",
          "venueName",
          "startsAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "venueId": {
            "type": "string"
          },
          "venueName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PriceCategoryDto": {
        "required": [
          "id",
          "name",
          "price"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "RoomSummaryDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "SeatDto": {
        "required": [
          "column",
          "type",
          "status"
        ],
        "type": "object",
        "properties": {
          "column": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "SeatMapDto": {
        "required": [
          "eventId",
          "roomId",
          "roomName",
          "rowLabels",
          "columns",
          "rows"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
          },
          "rowLabels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeatRowDto"
            }
          }
        }
      },
      "SeatRowDto": {
        "required": [
