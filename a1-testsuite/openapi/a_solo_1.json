          "name",
          "email",
          "sitzplaetze"
        ],
        "type": "object",
        "properties": {
          "veranstaltungId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "sitzplaetze": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuchungPositionRequestDto"
            }
          }
        }
      },
      "BuchungPositionRequestDto": {
        "required": [
          "reihe",
          "spalte",
          "preiskategorieId"
        ],
        "type": "object",
        "properties": {
          "reihe": {
            "type": "string"
          },
          "spalte": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "preiskategorieId": {
            "type": "string"
          }
        }
      },
      "BuchungPositionResponseDto": {
        "required": [
          "reihe",
          "spalte",
          "preiskategorieId",
          "preiskategorieName",
          "preis"
        ],
        "type": "object",
        "properties": {
          "reihe": {
            "type": "string"
          },
          "spalte": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "preiskategorieId": {
            "type": "string"
          },
          "preiskategorieName": {
            "type": "string"
          },
          "preis": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BuchungResponseDto": {
        "required": [
          "referenz",
          "name",
          "email",
          "status",
          "erstelltAm",
          "veranstaltungId",
          "veranstaltungTitel",
          "veranstaltungZeitpunkt",
          "spielstaetteName",
          "raumName",
          "positionen",
          "gesamtpreis"
        ],
        "type": "object",
        "properties": {
          "referenz": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "erstelltAm": {
            "type": "string",
            "format": "date-time"
          },
          "veranstaltungId": {
            "type": "string"
          },
