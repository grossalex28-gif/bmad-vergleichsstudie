              "string"
            ],
            "format": "int32"
          },
          "gangSpalten": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "gangHinweis": {
            "type": [
              "null",
