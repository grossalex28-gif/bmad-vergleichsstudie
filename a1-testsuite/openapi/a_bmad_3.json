  "components": {
    "schemas": {
      "BuchungAnlegenRequestDto": {
        "required": [
          "name",
          "email",
          "positionen"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "positionen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuchungspositionRequestDto"
            }
          }
        }
      },
      "BuchungDetailDto": {
        "required": [
          "referenz",
          "veranstaltungId",
          "veranstaltungTitel",
          "veranstaltungZeitpunkt",
          "spielstaetteName",
          "raumName",
          "name",
          "email",
          "status",
          "gesamtpreis",
          "positionen"
        ],
        "type": "object",
        "properties": {
          "referenz": {
            "type": "string"
          },
          "veranstaltungId": {
            "type": "string"
          },
          "veranstaltungTitel": {
            "type": "string"
          },
          "veranstaltungZeitpunkt": {
            "type": "string",
            "format": "date-time"
          },
          "spielstaetteName": {
            "type": "string"
          },
          "raumName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "gesamtpreis": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "positionen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuchungspositionDto"
            }
          }
        }
      },
      "BuchungspositionDto": {
        "required": [
          "sitzplatzCode",
          "preiskategorieId",
          "preiskategorieName",
          "preisSnapshot"
        ],
        "type": "object",
        "properties": {
          "sitzplatzCode": {
            "type": "string"
          },
          "preiskategorieId": {
            "type": "string"
          },
          "preiskategorieName": {
            "type": "string"
          },
          "preisSnapshot": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BuchungspositionRequestDto": {
        "required": [
          "sitzplatzCode",
          "preiskategorieId"
        ],
        "type": "object",
        "properties": {
          "sitzplatzCode": {
            "type": "string"
          },
          "preiskategorieId": {
            "type": "string"
          }
        }
      },
      "PreiskategorieDto": {
        "required": [
          "id",
          "name",
          "preis"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "preis": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "SitzplanDto": {
        "required": [
          "veranstaltungId",
          "raumId",
          "raumName",
          "reihen"
        ],
        "type": "object",
        "properties": {
          "veranstaltungId": {
            "type": "string"
          },
          "raumId": {
            "type": "string"
          },
          "raumName": {
            "type": "string"
          },
          "reihen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SitzplanReiheDto"
            }
          }
        }
      },
      "SitzplanPositionDto": {
        "required": [
          "spalte",
          "typ",
          "code",
          "status"
        ],
        "type": "object",
        "properties": {
          "spalte": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "typ": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SitzplanReiheDto": {
        "required": [
          "reihe",
          "positionen"
        ],
        "type": "object",
        "properties": {
          "reihe": {
            "type": "string"
          },
          "positionen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SitzplanPositionDto"
            }
          }
        }
      },
      "VeranstaltungDetailDto": {
        "required": [
          "id",
          "titel",
          "beschreibung",
          "dauerMinuten",
          "altersfreigabe",
          "spielstaetteName",
          "raumName",
          "zeitpunkt",
          "preiskategorien"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "titel": {
            "type": "string"
          },
          "beschreibung": {
            "type": "string"
          },
          "dauerMinuten": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "altersfreigabe": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "spielstaetteName": {
            "type": "string"
          },
          "raumName": {
            "type": "string"
          },
          "zeitpunkt": {
            "type": "string",
            "format": "date-time"
          },
          "preiskategorien": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PreiskategorieDto"
            }
          }
        }
      },
      "VeranstaltungListeDto": {
        "required": [
          "id",
          "titel",
          "spielstaetteId",
          "spielstaetteName",
          "zeitpunkt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "titel": {
            "type": "string"
          },
          "spielstaetteId": {
            "type": "string"
          },
          "spielstaetteName": {
            "type": "string"
          },
          "zeitpunkt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Buchungen"
    },
    {
      "name": "Veranstaltungen"
    }
