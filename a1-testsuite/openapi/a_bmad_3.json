            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BuchungAnlegenRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BuchungAnlegenRequestDto"
